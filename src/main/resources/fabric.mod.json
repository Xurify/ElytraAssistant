{
  "schemaVersion": 1,
  "depends": {
    "minecraft": "${minecraft_compatibility}",
    "fabric-api": "*",
    "java": ">=25",
    "fabricloader": ">=0.19.3",
    "cloth-config": ">=${cloth_config_version}"
  },
  "icon": "assets/elytraassistant/icon.png",
